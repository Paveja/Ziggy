{
  "name": "ziggy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "type-check": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src scripts *.json *.mjs",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "drizzle-orm": "latest",
    "better-sqlite3": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "typescript": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/better-sqlite3": "latest",
    "tailwindcss": "latest",
    "@tailwindcss/postcss": "latest",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.6",
    "prettier": "latest",
    "tsx": "latest"
  }
}
